@baseUrl = http://localhost:8080/api
@user = ana
@productId = 0d2873d5-6625-4190-8d82-386983bee97e

### 1. Primera pagina de productos

GET {{baseUrl}}/products?page=1&limit=4


### 2. Segunda pagina

GET {{baseUrl}}/products?page=2&limit=4


### 3. Tercera pagina

GET {{baseUrl}}/products?page=3&limit=4


### 4. Buscar productos

GET {{baseUrl}}/products?page=1&limit=4&title=Manzana


### 5. Obtener producto por ID

GET {{baseUrl}}/products/{{productId}}


### 6. Consultar carrito

GET {{baseUrl}}/cart
x-user: {{user}}


### 7. Agregar dos unidades

POST {{baseUrl}}/cart/items
Content-Type: application/json
x-user: {{user}}

{
    "productId": "{{productId}}",
    "quantity": 2
}


### 8. Agregar otra unidad del mismo producto

POST {{baseUrl}}/cart/items
Content-Type: application/json
x-user: {{user}}

{
    "productId": "{{productId}}",
    "quantity": 1
}


### 9. Comprobar cantidad acumulada

GET {{baseUrl}}/cart
x-user: {{user}}


### 10. Actualizar cantidad

PATCH {{baseUrl}}/cart/items/{{productId}}
Content-Type: application/json
x-user: {{user}}

{
    "quantity": 5
}


### 11. Cantidad negativa - Error 400

PATCH {{baseUrl}}/cart/items/{{productId}}
Content-Type: application/json
x-user: {{user}}

{
    "quantity": -2
}


### 12. Cantidad decimal - Error 400

PATCH {{baseUrl}}/cart/items/{{productId}}
Content-Type: application/json
x-user: {{user}}

{
    "quantity": 2.5
}


### 13. Stock insuficiente - Error 409

PATCH {{baseUrl}}/cart/items/{{productId}}
Content-Type: application/json
x-user: {{user}}

{
    "quantity": 1000
}


### 14. Producto inexistente - Error 404

POST {{baseUrl}}/cart/items
Content-Type: application/json
x-user: {{user}}

{
    "productId": "producto-inexistente",
    "quantity": 1
}


### 15. Solicitud sin usuario - Error 400

GET {{baseUrl}}/cart


### 16. Eliminar producto - Respuesta 204

DELETE {{baseUrl}}/cart/items/{{productId}}
x-user: {{user}}


### 17. Consultar carrito despues de eliminar

GET {{baseUrl}}/cart
x-user: {{user}}